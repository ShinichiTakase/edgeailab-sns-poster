# Copy this file to .env before running docker compose
# cp .env.example .env

THREADS_APP_ID=4657548184531509
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
THREADS_APP_SECRET=REPLACE_ME
THREADS_REDIRECT_URI=https://edgeailab.net/threads/callback

# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
X_CLIENT_ID=REPLACE_ME
X_CLIENT_SECRET=REPLACE_ME
X_REDIRECT_URI=https://edgeailab.net/oauth/x/callback

# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
FACEBOOK_APP_ID=REPLACE_ME
FACEBOOK_APP_SECRET=REPLACE_ME
FACEBOOK_CONFIG_ID=REPLACE_ME
FACEBOOK_REDIRECT_URI=https://edgeailab.net/oauth/facebook/callback

INSTAGRAM_APP_ID=1757363658736359
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
INSTAGRAM_APP_SECRET=REPLACE_ME
INSTAGRAM_REDIRECT_URI=https://edgeailab.net/oauth/instagram/callback
# testInstagramPost.js（投稿テストスクリプト）専用。インターネットから取得可能な公開URLであること
INSTAGRAM_TEST_IMAGE_URL=REPLACE_ME

# メール送信用（mail.edgeailab.netへの認証付き中継）。
# ADDRESS_TOはXトークンのリフレッシュ失敗時アラートの宛先、
# MAIL_FROM_NAMEは顧客向け（認証メール・トライアル終了リマインド）の表示名
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
SMTP_HOST=mail.edgeailab.net
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=info@edgeailab.net
ADDRESS_TO=info@edgeailab.net

# customers スキーマ（サインアップ/認証/課金用）。APIキーは既存のMICROCMS_API_KEYを流用
MICROCMS_SERVICE_DOMAIN=sns-poster

# サインインセッション用JWTの署名鍵（openssl rand -hex 32 等で生成）
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
JWT_SECRET=REPLACE_ME

MAIL_FROM_NAME=EdgeAI Lab

# 認証メール内リンクなどの組み立てに使うフロントエンド（edgeailab.net）のベースURL
APP_BASE_URL=https://edgeailab.net

# Stripe（本契約時のCheckout Session作成・Webhook検証用）
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
# 各プランのRecurring Price（基本料金）とMetered Price（投稿従量課金、sns_poster_posts Meter）
STRIPE_PRICE_BASIC_BASE=REPLACE_ME
STRIPE_PRICE_BASIC_METERED=REPLACE_ME
STRIPE_PRICE_STANDARD_BASE=REPLACE_ME
STRIPE_PRICE_STANDARD_METERED=REPLACE_ME
STRIPE_PRICE_ADVANCED_BASE=REPLACE_ME
STRIPE_PRICE_ADVANCED_METERED=REPLACE_ME

# AI文案生成（ワンショット投稿ウィザードの[AI文案生成]）用。
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
ANTHROPIC_API_KEY=REPLACE_ME

# スケジュール投稿「投稿文章を追加」で一度に生成する候補数（ラウンドロビン用バリエーション、
# Instagramリール動画のスロット数も同じ値を使う）。コスト調整・A/Bテスト用。
# 未設定・不正な値（0以下、非数値）の場合はデフォルト値5にフォールバックする
# （src/lib/generationConfig.js参照）。変更後はコンテナの再作成が必要。
DOCS_NUMBER=5

# 「友達に紹介」機能: 被紹介者がトライアル満了＋支払い登録済み（本稼働）に至った時点で
# 紹介者に付与するコイン数（sns-poster-referral-coin-grant cron参照）
FRIEND_COIN=500

PORT=3000
