# Copy this file to .env before running docker compose
# cp .env.example .env

THREADS_APP_ID=4657548184531509
# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
THREADS_APP_SECRET=REPLACE_ME
THREADS_REDIRECT_URI=https://edgeailab.net/threads/callback

# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
X_CLIENT_ID=REPLACE_ME
X_CLIENT_SECRET=REPLACE_ME
X_REDIRECT_URI=https://edgeailab.net/oauth/x/callback

# 実際の値はサーバー上で手動設定する（Gitに含めないこと）
FACEBOOK_APP_ID=REPLACE_ME
FACEBOOK_APP_SECRET=REPLACE_ME
FACEBOOK_CONFIG_ID=REPLACE_ME
FACEBOOK_REDIRECT_URI=https://edgeailab.net/oauth/facebook/callback

# Xトークンのリフレッシュ失敗時アラート送信用（ローカルpostfixへの中継、認証なし）
SMTP_HOST=localhost
SMTP_PORT=25
ADDRESS_FROM=info@edgeailab.net
ADDRESS_TO=info@edgeailab.net

PORT=3000
